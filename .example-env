# Optional overrides:
# GEMINI_MODEL                  default gemini-2.5-flash
# GEMINI_TIMEOUT_MS             default 20000, keep under the function duration limit
# SUMMARY_PROCESSING_STALE_MS   default 120000, when a stuck job may be retried
# SUMMARY_DEBUG                 set to "true" to log full summary bodies