<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Requested Articles</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }

    body {
      font-family: Inter, Arial, sans-serif;
      margin: 0;
      background: #f0f2f5;
      color: #1a1a1a;
    }

    nav {
      background: #fff;
      border-bottom: 1px solid #e0e0e0;
      padding: 0 24px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    nav .brand { font-size: 16px; font-weight: 600; }

    .btn {
      padding: 6px 14px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      border: none;
      text-decoration: none;
      display: inline-block;
    }

    .btn-outline {
      background: transparent;
      border: 1px solid #d0d0d0;
      color: #333;
    }

    .btn-outline:hover { border-color: #999; background: #f9f9f9; }
    .btn-danger { background: #e53935; color: #fff; }
    .btn-danger:hover { background: #c62828; }

    .container {
      max-width: 860px;
      margin: 32px auto;
      padding: 0 16px;
    }

    .page-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 20px;
    }

    .page-header h1 { font-size: 20px; font-weight: 600; margin: 0; }

    .req-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .req-item {
      background: #fff;
      border-radius: 10px;
      padding: 18px 20px;
      border: 1px solid #e0e0e0;
      transition: border-color 0.2s;
    }

    .req-item:hover { border-color: #bbb; }

    .req-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 10px;
    }

    .req-title {
      font-size: 15px;
      font-weight: 600;
      margin: 0;
    }

    .status-pill {
      font-size: 11px;
      font-weight: 600;
      padding: 3px 8px;
      border-radius: 20px;
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }

    .status-Draft { background: #f5f5f5; color: #757575; }
    .status-Requested { background: #fff8e1; color: #f57f17; }
    .status-Complete { background: #e8f5e9; color: #2e7d32; }

    .req-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      font-size: 13px;
      color: #666;
      margin-bottom: 14px;
    }

    .req-note {
      font-size: 13px;
      color: #444;
      background: #f9f9f9;
      border-radius: 6px;
      padding: 8px 12px;
      margin-bottom: 14px;
      border-left: 3px solid #e0e0e0;
    }

    .req-actions { display: flex; justify-content: flex-end; }

    .load-more-wrap { text-align: center; margin: 28px 0 40px; }

    .btn-load-more {
      padding: 8px 24px;
      border-radius: 6px;
      border: 1px solid #d0d0d0;
      background: #fff;
      font-size: 14px;
      cursor: pointer;
    }

    .btn-load-more:hover { border-color: #999; }

    #no-more-articles { text-align: center; color: #999; font-size: 13px; margin: 20px 0; display: none; }
    .error-message { color: #e53935; text-align: center; margin: 20px 0; }
    .empty-state { text-align: center; color: #999; padding: 48px 0; }
  </style>
</head>

<body>
  <nav>
    <span class="brand">Admin Panel</span>
    <div>
      <a href="/admin/home" class="btn btn-outline">← Back to Articles</a>
    </div>
  </nav>

  <div class="container">
    <div class="page-header">
      <h1>Requested Articles</h1>
    </div>

    <% if (typeof error !== 'undefined') { %>
      <p class="error-message"><%= error %></p>
    <% } %>

    <ul class="req-list" id="req-list">
      <% if (reqarticle.length > 0) { %>
        <% reqarticle.forEach(article => { %>
          <li class="req-article-item req-item" data-id="<%= article._id %>">
            <div class="req-header">
              <h2 class="req-title"><%= article.requesteeName %> @ <%= article.company %></h2>
              <span class="status-pill status-<%= article.status %>"><%= article.status %></span>
            </div>
            <div class="req-meta">
              <span>Requested by <strong><%= article.requesterName %></strong> (<%= article.requesterEmailId %>)</span>
              <span>Contact: <%= article.requesteeContact %></span>
            </div>
            <% if (article.note) { %>
              <div class="req-note"><%= article.note %></div>
            <% } %>
            <div class="req-actions">
              <button class="btn btn-danger" onclick="deleteReq('<%= article._id %>', this)">Delete</button>
            </div>
          </li>
        <% }) %>
      <% } else { %>
        <div class="empty-state">No requested articles.</div>
      <% } %>
    </ul>

    <div class="load-more-wrap">
      <button id="load-more" class="btn-load-more">Load more ↓</button>
      <p id="no-more-articles">All requests loaded.</p>
    </div>
  </div>

  <script>
    let currentPage = 1;

    function buildReqHTML(article) {
      const statusClass = `status-${article.status}`;
      const note = article.note ? `<div class="req-note">${article.note}</div>` : '';
      return `
        <li class="req-item" data-id="${article._id}">
          <div class="req-header">
            <h2 class="req-title">${article.requesteeName} @ ${article.company}</h2>
            <span class="status-pill ${statusClass}">${article.status}</span>
          </div>
          <div class="req-meta">
            <span>Requested by <strong>${article.requesterName}</strong> (${article.requesterEmailId})</span>
            <span>Contact: ${article.requesteeContact}</span>
          </div>
          ${note}
          <div class="req-actions">
            <button class="btn btn-danger" onclick="deleteReq('${article._id}', this)">Delete</button>
          </div>
        </li>`;
    }

    function deleteReq(id, btn) {
      if (!confirm('Delete this request?')) return;
      fetch(`/admin/reqArticle/${id}`, { method: 'DELETE' })
        .then(r => {
          if (!r.ok) throw new Error();
          btn.closest('li').remove();
        })
        .catch(() => alert('Failed to delete.'));
    }

    document.getElementById('load-more').addEventListener('click', () => {
      currentPage += 1;
      fetch(`/api/anubhav/reqarticle?page=${currentPage}`)
        .then(r => r.json())
        .then(({ reqarticle, hasMore }) => {
          const list = document.getElementById('req-list');
          reqarticle.forEach(a => list.insertAdjacentHTML('beforeend', buildReqHTML(a)));
          if (!hasMore || reqarticle.length === 0) {
            document.getElementById('load-more').style.display = 'none';
            document.getElementById('no-more-articles').style.display = 'block';
          }
        })
        .catch(() => {
          document.getElementById('load-more').style.display = 'none';
          document.getElementById('no-more-articles').style.display = 'block';
        });
    });
  </script>
</body>

</html>
