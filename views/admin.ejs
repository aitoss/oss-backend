<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Panel</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }

    body {
      font-family: Inter, Arial, sans-serif;
      margin: 0;
      background: #f0f2f5;
      color: #1a1a1a;
    }

    nav {
      background: #fff;
      border-bottom: 1px solid #e0e0e0;
      padding: 0 24px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    nav .brand {
      font-size: 16px;
      font-weight: 600;
      color: #1a1a1a;
    }

    nav .nav-links {
      display: flex;
      gap: 8px;
      align-items: center;
    }

    .btn {
      padding: 6px 14px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      border: none;
      text-decoration: none;
      display: inline-block;
    }

    .btn-outline {
      background: transparent;
      border: 1px solid #d0d0d0;
      color: #333;
    }

    .btn-outline:hover { border-color: #999; background: #f9f9f9; }

    .btn-danger { background: #e53935; color: #fff; }
    .btn-danger:hover { background: #c62828; }

    .btn-approve { background: #2e7d32; color: #fff; }
    .btn-approve:hover { background: #1b5e20; }

    .btn-revoke { background: #e53935; color: #fff; }
    .btn-revoke:hover { background: #c62828; }

    .container {
      max-width: 860px;
      margin: 32px auto;
      padding: 0 16px;
    }

    .page-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 20px;
    }

    .page-header h1 {
      font-size: 20px;
      font-weight: 600;
      margin: 0;
    }

    .article-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .article-item {
      background: #fff;
      border-radius: 10px;
      padding: 18px 20px;
      border: 1px solid #e0e0e0;
      transition: border-color 0.2s;
    }

    .article-item:hover { border-color: #bbb; }

    .article-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 8px;
    }

    .article-title {
      font-size: 16px;
      font-weight: 600;
      margin: 0;
      line-height: 1.4;
    }

    .badge {
      flex-shrink: 0;
      font-size: 11px;
      font-weight: 600;
      padding: 3px 8px;
      border-radius: 20px;
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }

    .badge-live { background: #e8f5e9; color: #2e7d32; }
    .badge-pending { background: #fff8e1; color: #f57f17; }

    .article-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      font-size: 13px;
      color: #666;
      margin-bottom: 14px;
    }

    .article-meta span { display: flex; align-items: center; gap: 4px; }

    .type-pill {
      font-size: 11px;
      font-weight: 500;
      padding: 2px 8px;
      border-radius: 20px;
      background: #e8eaf6;
      color: #3949ab;
    }

    .article-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .load-more-wrap {
      text-align: center;
      margin: 28px 0 40px;
    }

    .btn-load-more {
      padding: 8px 24px;
      border-radius: 6px;
      border: 1px solid #d0d0d0;
      background: #fff;
      font-size: 14px;
      cursor: pointer;
    }

    .btn-load-more:hover { border-color: #999; }

    .error-message { color: #e53935; text-align: center; margin: 20px 0; }

    #no-more-articles {
      text-align: center;
      color: #999;
      font-size: 13px;
      margin: 20px 0;
      display: none;
    }

    .empty-state {
      text-align: center;
      color: #999;
      padding: 48px 0;
    }
  </style>
</head>

<body>
  <nav>
    <span class="brand">Admin Panel</span>
    <div class="nav-links">
      <a href="/admin/reqArticle" class="btn btn-outline">Requested Articles</a>
      <a href="/admin/logout" class="btn btn-danger">Logout</a>
    </div>
  </nav>

  <div class="container">
    <div class="page-header">
      <h1>Articles</h1>
    </div>

    <% if (typeof error !== 'undefined') { %>
      <p class="error-message"><%= error %></p>
    <% } %>

    <ul class="article-list" id="article-list">
      <% if (articles.length > 0) { %>
        <% articles.forEach(article => { %>
          <li class="article-item">
            <div class="article-header">
              <h2 class="article-title"><%= article.title %></h2>
              <span class="badge <%= article.isAuthentic ? 'badge-live' : 'badge-pending' %>">
                <%= article.isAuthentic ? 'Live' : 'Pending' %>
              </span>
            </div>
            <div class="article-meta">
              <span><strong><%= article.companyName %></strong></span>
              <span class="type-pill"><%= article.typeOfArticle %></span>
              <% const a = article.authorId || {}; %>
              <span><%= a.name || 'Unknown' %> &middot; <%= a.contact || a.email || '—' %></span>
              <span><%= new Date(article.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
            </div>
            <div class="article-actions">
              <a href="/admin/view-article/<%= article._id %>" class="btn btn-outline">View Details →</a>
              <form action="/admin/update-authentic/<%= article._id %>" method="post">
                <button type="submit" class="btn <%= article.isAuthentic ? 'btn-revoke' : 'btn-approve' %>">
                  <%= article.isAuthentic ? 'Revoke' : 'Approve' %>
                </button>
              </form>
            </div>
          </li>
        <% }) %>
      <% } else { %>
        <div class="empty-state">No articles yet.</div>
      <% } %>
    </ul>

    <div class="load-more-wrap">
      <button id="load-more" class="btn-load-more">Load more ↓</button>
      <p id="no-more-articles">All articles loaded.</p>
    </div>
  </div>

  <script>
    let currentPage = 1;

    function buildArticleHTML(article) {
      const date = new Date(article.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });
      const badgeClass = article.isAuthentic ? 'badge-live' : 'badge-pending';
      const badgeText = article.isAuthentic ? 'Live' : 'Pending';
      const btnClass = article.isAuthentic ? 'btn-revoke' : 'btn-approve';
      const btnText = article.isAuthentic ? 'Revoke' : 'Approve';
      const author = article.authorId || {};
      const authorName = author.name || 'Unknown';
      const authorContact = author.contact || author.email || '—';
      return `
        <li class="article-item">
          <div class="article-header">
            <h2 class="article-title">${article.title}</h2>
            <span class="badge ${badgeClass}">${badgeText}</span>
          </div>
          <div class="article-meta">
            <span><strong>${article.companyName}</strong></span>
            <span class="type-pill">${article.typeOfArticle}</span>
            <span>${authorName} &middot; ${authorContact}</span>
            <span>${date}</span>
          </div>
          <div class="article-actions">
            <a href="/admin/view-article/${article._id}" class="btn btn-outline">View Details →</a>
            <form action="/admin/update-authentic/${article._id}" method="post">
              <button type="submit" class="btn ${btnClass}">${btnText}</button>
            </form>
          </div>
        </li>`;
    }

    document.getElementById('load-more').addEventListener('click', () => {
      currentPage += 1;
      fetch(`/api/anubhav/articles?page=${currentPage}`)
        .then(r => r.json())
        .then(({ articles, hasMore }) => {
          const list = document.getElementById('article-list');
          articles.forEach(a => list.insertAdjacentHTML('beforeend', buildArticleHTML(a)));
          if (!hasMore || articles.length === 0) {
            document.getElementById('load-more').style.display = 'none';
            document.getElementById('no-more-articles').style.display = 'block';
          }
        })
        .catch(() => {
          document.getElementById('load-more').style.display = 'none';
          document.getElementById('no-more-articles').style.display = 'block';
        });
    });
  </script>
</body>

</html>
